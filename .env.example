POSTGRES_DB=oad_demo
POSTGRES_USER=oad
POSTGRES_PASSWORD=oad_local_only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional Snowflake connection. Required for analytics, AI/ML and chat.
# Leave account, user, password and warehouse blank to use PostgreSQL only.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=OAD_DEMO
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=
SNOWFLAKE_TABLE=AI4I_READINGS
